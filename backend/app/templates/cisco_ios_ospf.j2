! ------------------------------------------------------------------
! Generated by AI Network Automation System
! Plan {{ plan_id }} | device {{ device_id }} | REVIEW BEFORE APPROVAL
! Management interface and SSH/VTY settings are intentionally untouched.
! ------------------------------------------------------------------
! 1) Clean-up: remove any previous OSPF and reset the data-plane interfaces
{% for p in cleanup.ospf_processes %}
no router ospf {{ p }}
{% endfor %}
{% for n in cleanup.interfaces %}
default interface {{ n }}
{% endfor %}
! 2) New configuration
hostname {{ hostname }}
!
{% for i in interfaces %}
interface {{ i.name }}
 description {{ i.description }}
 ip address {{ i.ip }} {{ i.netmask }}
{% if i.p2p %}
 ip ospf network point-to-point
{% endif %}
 no shutdown
 exit
!
{% endfor %}
router ospf {{ ospf.process_id }}
 router-id {{ ospf.router_id }}
{% for n in ospf.networks %}
 network {{ n.address }} {{ n.wildcard }} area {{ ospf.area }}
{% endfor %}
{% for p in ospf.passive %}
 passive-interface {{ p }}
{% endfor %}
 exit
!
end
