# Copy to .env, fill in, then: chmod 600 .env   (.env is git-ignored - never submit it)

# ---- AI (backend only) ----------------------------------------------------
# anthropic | openai | local   ("mock" = offline fixture for development, NOT for the demo)
#   anthropic = Claude API key
#   openai    = OpenAI, or ANY OpenAI-compatible cloud API via OPENAI_BASE_URL (examples below)
#   local     = a model running on your own machine (Ollama, LM Studio, vLLM, llama.cpp)
# The model must accept images (it reads the topology diagram).
AI_PROVIDER=anthropic
# Leave empty for the default (anthropic: claude-sonnet-5-5, openai: gpt-4o,
# local: qwen2.5vl:7b). For other services put that service's model name here.
AI_MODEL=
ANTHROPIC_API_KEY=

# ---- AI_PROVIDER=openai: OpenAI or an OpenAI-compatible API key ----------------
OPENAI_API_KEY=
# OpenAI (default)        https://api.openai.com/v1
# Google Gemini (free)    https://generativelanguage.googleapis.com/v1beta/openai
# Groq (free)             https://api.groq.com/openai/v1
# OpenRouter              https://openrouter.ai/api/v1
# GitHub Models           https://models.github.ai/inference
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- AI_PROVIDER=local: model server on this machine ------------------------
# Ollama (default)        http://host.docker.internal:11434/v1
# LM Studio               http://host.docker.internal:1234/v1
LOCAL_AI_BASE_URL=http://host.docker.internal:11434/v1
# Most local servers need no key
LOCAL_AI_API_KEY=
# Seconds to wait for a local answer (CPU-only inference can take minutes)
LOCAL_AI_TIMEOUT=600

# Set false if a service rejects "response_format" (the reply is still parsed as JSON)
AI_JSON_MODE=true

# ---- GNS3 lab cross-check (optional, read-only) ----------------------------------
# Between AI analysis and the interface mapping: checks the AI topology against the real
# GNS3 cabling and suggests which router port carries which network. GET requests only -
# it never changes the lab or touches the routers; you still confirm and approve.
GNS3_ENABLED=false
GNS3_URL=http://192.168.192.131
# auto = detect: v3 for GNS3 3.x, v2 for GNS3 2.2 (2.2 local server: http://localhost:3080)
GNS3_API=auto
GNS3_PROJECT=ai-netauto-ospf
# GNS3 3.x: an API token (e.g. a read-only user's key) ...
GNS3_TOKEN=
# ... or a username/password (a read-only GNS3 user is recommended).
# GNS3 2.2: leave all empty if auth is off, or set the server's username/password
GNS3_USERNAME=
GNS3_PASSWORD=

# ---- Access tokens ----------------------------------------------------------
# Generate each with:  openssl rand -hex 24
ADMIN_TOKEN=change-me-admin-token
WORKER_TOKEN=change-me-worker-token

# ---- Router SSH credentials (worker only) ---------------------------------
ROUTER_SSH_USERNAME=netadmin
ROUTER_SSH_PASSWORD=
# Only needed if the account logs in at user EXEC (>) instead of privileged (#)
ROUTER_ENABLE_SECRET=
# Per-router override example: R1_SSH_PASSWORD=...

# ---- Behaviour --------------------------------------------------------------
SSH_TIMEOUT=15
# Retries after timeout/unreachable (not after auth failures). Emulated routers can refuse
# SSH for several seconds right after a deploy; 5 retries wait up to ~30 s.
SSH_RETRIES=5
# accept-new (trust on first use, then pin) | strict (only keys already in known_hosts)
SSH_HOST_KEY_POLICY=accept-new
# Seconds the worker keeps re-checking OSPF (adjacency can take ~40s on broadcast links)
VERIFY_TIMEOUT=180
# true = "ip ospf network point-to-point" on router-to-router links (FULL in seconds, no DR/BDR)
OSPF_TRANSIT_P2P=true
DISCOVERY_MAX_AGE_MIN=120
