# Settings. Copy this file to .env and fill it in.
# .env holds secrets: never share or submit it (git already ignores it).

# ---- AI model (must be able to read images) --------------------------------
#   anthropic = Claude          openai = OpenAI or another OpenAI-style cloud API
#   local     = a model on your own PC (Ollama, LM Studio)
#   mock      = fake answer for code testing only - not for the demo
AI_PROVIDER=anthropic
# Model name. Empty = default (anthropic: claude-sonnet-5-5, openai: gpt-4o, local: qwen2.5vl:7b)
AI_MODEL=
ANTHROPIC_API_KEY=

# For AI_PROVIDER=openai: the key, and the address of the service
OPENAI_API_KEY=
#   OpenAI         https://api.openai.com/v1
#   Google Gemini  https://generativelanguage.googleapis.com/v1beta/openai
#   Groq           https://api.groq.com/openai/v1
#   OpenRouter     https://openrouter.ai/api/v1
#   GitHub Models  https://models.github.ai/inference
OPENAI_BASE_URL=https://api.openai.com/v1

# For AI_PROVIDER=local: the address of the model server (Ollama shown; LM Studio uses port 1234)
LOCAL_AI_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_AI_API_KEY=
# Seconds to wait for a local answer
LOCAL_AI_TIMEOUT=600
# Set to false if the AI service rejects "response_format"
AI_JSON_MODE=true

# ---- Optional: GNS3 cable check (read only - never changes the lab) --------
GNS3_ENABLED=false
# Your GNS3 server, e.g. http://<gns3-vm-ip> (GNS3 2.2 local server: http://host.docker.internal:3080)
GNS3_URL=
GNS3_PROJECT=ai-netauto-ospf
# auto, v3 (GNS3 3.x) or v2 (GNS3 2.2)
GNS3_API=auto
# GNS3 3.x: an API token, or a username and password. GNS3 2.2: often none needed.
GNS3_TOKEN=
GNS3_USERNAME=
GNS3_PASSWORD=

# ---- Access tokens: two different long random strings ----------------------
# Make one with:  openssl rand -hex 24
ADMIN_TOKEN=change-me-admin-token
WORKER_TOKEN=change-me-worker-token

# ---- Router login (used only by the worker) --------------------------------
ROUTER_SSH_USERNAME=netadmin
ROUTER_SSH_PASSWORD=
# Only if the login lands at the ">" prompt instead of "#"
ROUTER_ENABLE_SECRET=

# ---- Advanced (defaults are fine) -----------------------------------------
SSH_TIMEOUT=15
# Retries when a router does not answer (never after a wrong password)
SSH_RETRIES=5
# accept-new = trust a router's SSH key the first time, then require the same key
SSH_HOST_KEY_POLICY=accept-new
# Seconds to keep checking OSPF after a deploy
VERIFY_TIMEOUT=180
# true = R1-R2 link becomes FULL in seconds (point-to-point)
OSPF_TRANSIT_P2P=true
# Minutes an interface discovery stays valid
DISCOVERY_MAX_AGE_MIN=120
