# Settings. Copy this file to .env and fill it in.
# .env holds secrets: never share or submit it (git already ignores it).
# Every other setting has a working default - see "Other settings" in README.md.

# ---- AI model: Google Gemini (key from Google AI Studio) -------------------
AI_PROVIDER=openai
AI_MODEL=gemini-4-hydrogen
OPENAI_API_KEY=
# Gemini's address (also the default). Change it only to use another service - see README
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ---- Optional: OCR double-check (free key from Typhoon, opentyphoon.ai) ----
# Reads the text in the picture so the AI copies numbers instead of guessing. Empty = off
OCR_API_KEY=

# ---- Access tokens: two different long random strings ----------------------
# Make one with:  openssl rand -hex 24
ADMIN_TOKEN=change-me-admin-token
WORKER_TOKEN=change-me-worker-token

# ---- Router login (used only by the worker) --------------------------------
ROUTER_SSH_USERNAME=netadmin
ROUTER_SSH_PASSWORD=
