# Copy to .env, fill in, then: chmod 600 .env   (.env is git-ignored - never submit it)

# ---- AI (backend only) ----------------------------------------------------
# anthropic | openai   ("mock" = offline fixture for development, NOT for the demo)
AI_PROVIDER=anthropic
# Leave empty for the default (anthropic: claude-sonnet-5-5, openai: gpt-4o)
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Access tokens ----------------------------------------------------------
# Generate each with:  openssl rand -hex 24
ADMIN_TOKEN=change-me-admin-token
WORKER_TOKEN=change-me-worker-token

# ---- Router SSH credentials (worker only) ---------------------------------
ROUTER_SSH_USERNAME=netadmin
ROUTER_SSH_PASSWORD=
# Only needed if the account logs in at user EXEC (>) instead of privileged (#)
ROUTER_ENABLE_SECRET=
# Per-router override example: R1_SSH_PASSWORD=...

# ---- Behaviour --------------------------------------------------------------
SSH_TIMEOUT=15
# accept-new (trust on first use, then pin) | strict (only keys already in known_hosts)
SSH_HOST_KEY_POLICY=accept-new
# Seconds the worker keeps re-checking OSPF (adjacency can take ~40s on broadcast links)
VERIFY_TIMEOUT=180
# true = "ip ospf network point-to-point" on router-to-router links (FULL in seconds, no DR/BDR)
OSPF_TRANSIT_P2P=true
DISCOVERY_MAX_AGE_MIN=120
